/**
 * 追加テーマを Themes / Spots シートへ登録（既にある theme_id は飛ばす）
 * Code.gs の HEADERS / readAll_ / sheet_ / cell_ を利用します。
 */
function addThemes() {
  const existing = new Set(readAll_('Themes').map(t => t.theme_id));
  let sort = readAll_('Themes').reduce((m, t) => Math.max(m, Number(t.sort) || 0), 0);
  const themeRows = [];
  const spotRows = [];
  const added = [];

  EXTRA_THEMES.forEach(th => {
    if (existing.has(th.id)) return;
    sort++;
    const t = { theme_id: th.id, name: th.name, subtitle: th.subtitle, description: th.description, guide_name: th.guide, sort: sort, active: true };
    themeRows.push(HEADERS.Themes.map(h => cell_(t[h])));
    th.spots.forEach((r, i) => {
      const s = {
        spot_id: th.prefix + '-' + ('0' + (i + 1)).slice(-2), theme_id: th.id, order: i + 1,
        name: r[0], kana: r[1], pref: r[2], lat: r[3], lng: r[4],
        haiku: r[5], haiku_author: r[6], season: r[7], description: r[8],
        earth_video_url: '', image_url: ''
      };
      spotRows.push(HEADERS.Spots.map(h => cell_(s[h])));
    });
    added.push(th.name + '（' + th.spots.length + '）');
  });

  withLock_(() => {
    if (themeRows.length) {
      const sh = sheet_('Themes');
      sh.getRange(sh.getLastRow() + 1, 1, themeRows.length, HEADERS.Themes.length).setValues(themeRows);
    }
    if (spotRows.length) {
      const sh = sheet_('Spots');
      sh.getRange(sh.getLastRow() + 1, 1, spotRows.length, HEADERS.Spots.length).setValues(spotRows);
    }
  });
  console.log(added.length ? '追加しました: ' + added.join('、') : '追加するテーマはありませんでした（全て登録済み）');
}
